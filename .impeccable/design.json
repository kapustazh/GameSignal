  "narrative": {
    "northStar": "Modular color, monumental type",
    "overview": "Technical yet playful. Cool grey fields and near-black grotesk typography make software feel tactile and approachable. Bright modular blocks, saturated blue chapters and forest-green surfaces give the page a graphic identity. The supplied Composer reference establishes this world, while the implemented Inter typography and component dimensions are authoritative for GameSignal.\n\nPacing is spacious between chapters and compact inside demonstrations. Product interfaces float like physical objects. Large live lettering anchors the composition while small directional arrows keep actions clear.\n",
    "keyCharacteristics": [
      "Monumental live typography over hard-edged modular color.",
      "Neutral reading fields with concentrated saturated chapters.",
      "Continuous rules, directional capsules and architectural product artifacts.",
      "Green panels with staggered pink word blocks and a forest utility ending."
    ],
    "rules": [
      {
        "name": "The Concentrated Color Rule",
        "body": "Keep reading fields neutral and place saturated color in modular art or deliberate chapter-scale surfaces.",
        "section": "colors"
      },
      {
        "name": "The Live Name Rule",
        "body": "Preserve the product name’s dominant scale and fit it deliberately at each width.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep the monumental product name as live Inter text.",
      "Do preserve neutral reading fields, modular color events and fine continuous rules.",
      "Do use full capsules for actions and compact corners for interface artifacts.",
      "Do retain visible keyboard focus and content visibility with reduced motion.",
      "Do use the implemented tablet and mobile layout transitions."
    ],
    "donts": [
      "Don't turn the ruled capability cells into oversized rounded floating cards.",
      "Don't replace the cool-grey reading canvas with white throughout.",
      "Don't place decorative blocks over essential supporting text.",
      "Don't distribute saturated fills or artifact shadows across every surface."
    ]
  }
}
